----------------------------------------------------------------
-- 5. Test Table Creation with LIKE INCLUDING COMPRESSION
----------------------------------------------------------------
DROP TABLE IF EXISTS cmdata_zstd_dict_2;
NOTICE:  table "cmdata_zstd_dict_2" does not exist, skipping
CREATE TABLE cmdata_zstd_dict_2 (LIKE cmdata_zstd_dict INCLUDING COMPRESSION);
--  Table Structure for cmdata_zstd_2
\d+ cmdata_zstd_dict_2;
                                  Table "public.cmdata_zstd_dict_2"
 Column | Type | Collation | Nullable | Default | Storage  | Compression | Stats target | Description 
--------+------+-----------+----------+---------+----------+-------------+--------------+-------------
 f1     | text |           |          |         | extended | zstd_dict   |              | 

DROP TABLE cmdata_zstd_dict_2;
----------------------------------------------------------------
-- 6. Materialized View Compression Test
----------------------------------------------------------------
DROP MATERIALIZED VIEW IF EXISTS compressmv_zstd_dict;
NOTICE:  materialized view "compressmv_zstd_dict" does not exist, skipping
CREATE MATERIALIZED VIEW compressmv_zstd_dict AS
  SELECT f1 FROM cmdata_zstd_dict;
--  Materialized View Structure for compressmv_zstd
\d+ compressmv_zstd_dict;
                           Materialized view "public.compressmv_zstd_dict"
 Column | Type | Collation | Nullable | Default | Storage  | Compression | Stats target | Description 
--------+------+-----------+----------+---------+----------+-------------+--------------+-------------
 f1     | text |           |          |         | extended |             |              | 
View definition:
 SELECT f1
   FROM cmdata_zstd_dict;

--  Materialized View Compression Check
SELECT pg_column_compression(f1) AS mv_compression
FROM compressmv_zstd_dict;
