-- Table Structure for cmdata_zstd
\d+ cmdata_zstd_nodict;
-- Compression Settings for f1 Column
SELECT pg_column_compression(f1) AS compression_method,
       count(*) AS row_count
FROM cmdata_zstd_nodict
GROUP BY pg_column_compression(f1);
