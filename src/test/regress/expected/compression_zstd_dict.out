\set HIDE_TOAST_COMPRESSION false
-- Ensure stable results regardless of the installation's default.
SET default_toast_compression = 'pglz';
----------------------------------------------------------------
-- 1. Create Test Table with Zstd Compression
----------------------------------------------------------------
DROP TABLE IF EXISTS cmdata_zstd_dict CASCADE;
NOTICE:  table "cmdata_zstd_dict" does not exist, skipping
CREATE TABLE cmdata_zstd_dict (
    f1 TEXT COMPRESSION zstd_dict
);
----------------------------------------------------------------
-- 2. Insert Data Rows
----------------------------------------------------------------
DO $$
BEGIN
  FOR i IN 1..15 LOOP
    INSERT INTO cmdata_zstd_dict (f1) VALUES (repeat('1234567890', 1004));
  END LOOP;
END $$;
-- Train dictionary for f1 column and insert more.
SELECT build_zstd_dict_for_attribute('cmdata_zstd_dict', 1);
 build_zstd_dict_for_attribute 
-------------------------------
 t
(1 row)

DO $$
BEGIN
  FOR i IN 1..15 LOOP
    INSERT INTO cmdata_zstd_dict (f1) VALUES (repeat('1234567890', 1004));
  END LOOP;
END $$;
select dictid from pg_zstd_dictionaries;
 dictid 
--------
      1
(1 row)

----------------------------------------------------------------
-- 3. Verify Table Structure and Compression Settings
----------------------------------------------------------------
-- Table Structure for cmdata_zstd
\d+ cmdata_zstd_dict;
                                   Table "public.cmdata_zstd_dict"
 Column | Type | Collation | Nullable | Default | Storage  | Compression | Stats target | Description 
--------+------+-----------+----------+---------+----------+-------------+--------------+-------------
 f1     | text |           |          |         | extended | zstd_dict   |              | 

-- Compression Settings for f1 Column
SELECT pg_column_compression(f1) AS compression_method,
       count(*) AS row_count
FROM cmdata_zstd_dict
GROUP BY pg_column_compression(f1);
 compression_method | row_count 
--------------------+-----------
 zstd_dict          |        30
(1 row)

